// ttGamba's database.
//
// Postgres, self-hosted alongside the app rather than reached over the network
// to Turso — see DEPLOYMENT.md for why. `prisma migrate deploy` works against
// it directly, unlike Turso's `libsql://`, so there is no shipped-as-raw-SQL
// deployer here the way there used to be. See lib/db.ts and packages/db for
// the connection machinery.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Gates what the app will show. Every player is a `player` until someone
/// makes them otherwise — there is no self-service route to the other two.
enum Role {
  superadmin
  /// Runs the deposit desk: takes in-game cash and credits chips for it.
  banker
  player
}

/// A player's standing with the casino.
///
/// This is the binding between a Transport Tycoon character and the chips it
/// holds. It stores only what the game client cannot tell us — a role and a
/// balance. Everything the client *can* answer (name, faction, Discord, wallet,
/// bank) is deliberately not mirrored here: a copy would only ever be a stale
/// version of what the player is already looking at. Where a name is needed
/// for an audit trail it belongs on that record, captured at the time, not on
/// a row that would rewrite history every time the player renamed.
model User {
  /// vRP `user_id`. The identity the server treats as the account, stable
  /// across reconnects and name changes, so it is the natural key — and, with
  /// the player name the client reports alongside it, the whole of identity.
  vrpId Int @id

  role Role @default(player)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  balance  Balance?
  requests Request[]
}

/// A player's chips, kept apart from the account that owns them.
///
/// One row per `User`, created with it. The split is not normalisation for its
/// own sake — it is what makes `User` cacheable (lib/db.ts):
///
/// A balance moves on every settled request and every payout, and a row that
/// is written constantly cannot be cached by anything. While `chips` lived on
/// `User`, caching `User` would have meant purging it on every chip movement,
/// so the role and identity beside it — read on every navigation and every
/// desk call, and changed almost never — could never be cached either. Apart,
/// each is cached according to how it actually behaves.
///
/// The consequence to respect: **never read a `User` with its `balance`
/// included.** A cached `User` row carrying an embedded balance is a stale
/// balance with none of the invalidation that protects the real one, and the
/// cache extension does not detect writes through a relation. Read the two
/// separately; `lib/account.ts` is the example.
model Balance {
  /// The account this belongs to. Shared primary key, so a player cannot have
  /// two balances and a balance cannot outlive its account.
  vrpId Int  @id
  user  User @relation(fields: [vrpId], references: [vrpId], onDelete: Cascade)

  /// Chips held, in whole chips. Never real money, and never in-game cash
  /// either — this balance only moves when a banker settles a deposit or a
  /// game pays out. See PRODUCT.md.
  ///
  /// Chips promised to an open withdrawal are *not* in here: they are taken
  /// out the moment the withdrawal is asked for, so a player cannot ask for
  /// them and then gamble them away before a banker gets to it. See
  /// lib/requests.ts.
  ///
  /// `BigInt`, not `Int`, and this is the reason: Prisma's `Int` is a 32-bit
  /// signed integer, which stops at 2,147,483,647 — and this server's high
  /// rollers bet in billions. Postgres's `bigint` is 64 bits, so the ceiling
  /// was never the database's. What changes is the type Prisma hands back,
  /// and lib/rows.ts is where that becomes a `number` again. See
  /// `AMOUNT_LIMIT` in lib/desk.ts for why that last step is safe.
  chips BigInt @default(0)

  updatedAt DateTime @updatedAt
}

/// Which way across the boundary the chips are meant to go.
///
/// The app cannot reach in-game money, so every crossing is a person handing
/// another person cash in the world and one of them being a banker. That is
/// the whole reason this table exists.
enum RequestKind {
  /// In-game cash to the banker, chips to the player.
  deposit
  /// Chips back to the house, in-game cash to the player.
  withdrawal
}

/// Where a request has got to.
///
/// Two ways out of `pending`, and only one of them continues: a banker either
/// takes it on (`approved`, meaning "I will do this") and then settles it
/// (`closed`, meaning "the money has changed hands"), or turns it down
/// (`denied`). `cancelled` is the player's own way out, open to them for as
/// long as nothing has been settled.
enum RequestStatus {
  pending
  approved
  closed
  denied
  cancelled
}

/// A player asking a banker to move chips across the in-game boundary.
///
/// A player may have as many of these open as they like, of either kind, so
/// nothing here is unique per player — the list is the record.
model Request {
  id Int @id @default(autoincrement())

  kind   RequestKind
  status RequestStatus @default(pending)

  /// Always positive; `kind` carries the direction. Whole chips, like every
  /// other figure in this schema — and `BigInt` for the same reason the
  /// balance is.
  amount BigInt

  player User @relation(fields: [vrpId], references: [vrpId])
  vrpId  Int

  /*
    Who the player was when they asked.

    The User row deliberately mirrors none of this (see its comment), and
    ordinarily that is right — a name read live from the client is never
    stale. A request is the exception: it is a record of something that
    happened, and a banker reviewing one needs the character that made it, not
    whoever holds the account by the time they get round to it. Renaming
    afterwards must not rewrite the desk's paperwork.

    Nullable throughout because the client is allowed not to know: a player in
    no faction, an account with no Discord linked, or simply a key that had not
    arrived yet when the request was made.

    The client also reports a source id — which server slot the player is
    sitting in — and it is deliberately not here. It is true for one session
    and meaningless afterwards, so on a record that outlives the session it
    would read as identity while being nothing of the kind.
  */
  playerName  String?
  discordId   String?
  steamId     String?
  factionName String?
  factionTag  String?

  /// The note attached to the most recent move — usually why it was denied.
  /// Every note ever attached is on the audit trail; this is the current one,
  /// so the list can show it without a join.
  note String?

  /// The banker who last moved it. Their name is captured for the same reason
  /// the player's is.
  handledByVrpId Int?
  handledByName  String?
  handledAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events AuditEvent[]

  /// The desk's two working queues: one kind, oldest first.
  @@index([kind, status, createdAt])
  /// Everything one player has ever asked for — the lookup tab.
  @@index([vrpId, createdAt])
  /// Settled requests inside a window, for the 24-hour figures.
  @@index([status, handledAt])
}

/// A game the casino offers.
///
/// The *definition* — "Blackjack", "Roulette" — and nothing about a round in
/// progress. It is a database row rather than a constant in the source because
/// the shelf is something an administrator arranges: which games are on it,
/// what order they come in, and what each one is called. See lib/catalogue.ts.
///
/// A game has no rules of its own. `engine` names the code that plays it, and
/// everything below this row exists so that the engine has somewhere to sit —
/// see `Tier`, `Table` and `Shoe`.
model Game {
  id Int @id @default(autoincrement())

  /// The address it lives at: `/play/blackjack`. Lower-case, hyphenated, and
  /// unique because it is what a route resolves against.
  slug String @unique

  name String
  /// A one-liner for the stage header and the games index.
  blurb String?

  /// A Phosphor icon name — `Spade`, `PokerChip`, `RoadHorizon`.
  ///
  /// Free text, checked by nothing here. An administrator types a name and the
  /// rail tries to load it; a name that is not an icon falls back to a generic
  /// glyph rather than breaking the shelf (components/icon.tsx). Storing a
  /// verified id instead would mean a schema change every time Phosphor adds a
  /// glyph, for a field whose failure mode is a wrong picture.
  icon String @default("PokerChip")

  /// Which engine plays it — a key from the registry in lib/engines.ts.
  ///
  /// Also free text, and for a sharper reason: an administrator pointing a game
  /// at an engine that does not exist is a mistake that has to be *visible*
  /// rather than impossible. It is caught when a player opens the game and
  /// reported as a slate naming the engine it could not find
  /// (components/games/failed.tsx). An enum would move that failure to a
  /// migration, where the person who made it never sees it.
  engine String

  /// Whether the shelf lists it. Off is how a game is built, or retired,
  /// without deleting the tables and the history hanging off it.
  inRail Boolean @default(true)

  /// Where it comes in the shelf. Dense and zero-based, rewritten wholesale
  /// every time the list is saved — see `saveCatalogue`.
  position Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tiers Tier[]

  /// The shelf's order, which is every read of this table.
  @@index([position])
}

/// A class of table: what it costs to sit at one, and how many are kept open.
///
/// The layer between a game and a table, and the thing an administrator
/// actually configures. "Blackjack" is a game; "Blackjack, 1M–10M, five seats"
/// is a tier, and the tables a player sits at are instances of it.
///
/// ── Why the tables are not configured directly ────────────────────────────
/// Because a fixed list of tables can fill up, and a casino whose tables are
/// all full turns players away. `floor` is how many are kept open at all times
/// — what the lobby shows on a quiet night — and when every table in a tier is
/// occupied the app opens another beyond it. So the admin panel describes the
/// *kind* of table on offer and the floor decides how many of them there are at
/// any moment. See `ensureTables` in lib/tables.ts.
/// ─────────────────────────────────────────────────────────────────────────
///
/// Singleplayer games have tiers too, and they are the stakes the player picks
/// before the game loads. A singleplayer game with one tier has nothing to pick
/// and goes straight to the table.
model Tier {
  id Int @id @default(autoincrement())

  game   Game @relation(fields: [gameId], references: [id], onDelete: Cascade)
  gameId Int

  /// How it reads in the lobby — "Low Roller", "High Roller".
  name String

  /// The bet a table of this class will take, in whole chips. `BigInt` for the
  /// same reason a balance is: this server bets in billions.
  minBet BigInt
  maxBet BigInt

  /// Seats at one of its tables. Singleplayer tiers are one, and nothing
  /// enforces that here — the engine's own seat count is what the app builds
  /// against (lib/engines.ts).
  seats Int @default(5)

  /// Tables of this class kept open whether or not anyone is at them. Zero is
  /// legal and means "open one when somebody asks", which is what a
  /// singleplayer tier wants: a private table each, none standing empty.
  floor Int @default(1)

  /// How many decks go into this class of table's shoe — a range, not a
  /// number, and re-rolled every time the shoe is restocked.
  ///
  /// A fixed shoe size is a thing a counter can rely on: they know how many
  /// cards are in play, so every card seen tells them about the ones left. A
  /// shoe that might be four decks or might be six means the denominator they
  /// are counting against is itself unknown, and a running count is worth much
  /// less. Together with the randomised cut card (lib/shoe.ts) that is the
  /// whole of this table's defence, and it costs an honest player nothing.
  ///
  /// Set both to the same number for a fixed shoe. Ignored entirely by a game
  /// whose engine deals no cards.
  minDecks Int @default(4)
  maxDecks Int @default(6)

  position Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tables Table[]

  /// The lobby: one game's tiers, in the order the admin put them.
  @@index([gameId, position])
}

/// Somewhere to sit and play.
///
/// Every game gets these, singleplayer included. A singleplayer game will never
/// show a player a list of them — the table is made for them and they are put
/// at it — but the table is still what owns the shoe, the seat and the round in
/// progress, and having one shape for both is what keeps an engine from having
/// to know which kind of game it is playing.
model Table {
  id Int @id @default(autoincrement())

  tier   Tier @relation(fields: [tierId], references: [id], onDelete: Cascade)
  tierId Int

  /// Its number within the tier — "High Roller 3". Dense from 1, and reused
  /// once a table is reaped.
  number Int

  /// Opened because the tier's others were full, rather than because the floor
  /// says it should exist. The difference only matters when it empties: an
  /// overflow table is taken away again, a floor table stays and waits.
  overflow Boolean @default(false)

  /// The one player a private table belongs to. Set for every singleplayer
  /// table, and the hook the paid solo-table upgrade will hang off later
  /// (PRODUCT.md). `null` is a public table.
  ownerVrpId Int?

  /// The engine's own state for the round in progress, as JSON.
  ///
  /// Opaque here on purpose: what a hand of blackjack looks like is the
  /// engine's business, and a column per game would be a migration per game.
  /// Read defensively — a table can outlive the version of the engine that
  /// wrote its state.
  state String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// When the last player got up, or `null` while somebody is still sitting
  /// there. What the reaper works from — see `sweep` in lib/tables.ts.
  emptiedAt DateTime?

  seats TableSeat[]
  shoe  Shoe?

  /// The lobby reads a tier's tables in number order.
  @@unique([tierId, number])
  /// A player's private table, found without scanning the tier.
  @@index([ownerVrpId])
}

/// A player, sitting at a table.
///
/// Its own row rather than a list on the table, because sitting down is a thing
/// two players can try to do at once and only the database can decide between
/// them: the unique constraint on the seat number is what makes the loser lose
/// rather than both of them ending up in the same chair.
model TableSeat {
  id Int @id @default(autoincrement())

  table   Table @relation(fields: [tableId], references: [id], onDelete: Cascade)
  tableId Int

  /// Which chair, from 1. Bounded by the tier's `seats` when it is taken.
  position Int

  vrpId Int
  /// Who they were when they sat down, for the same reason a request captures
  /// it — the table shows the character at it, not whoever holds the account by
  /// the time somebody looks.
  playerName String?

  joinedAt DateTime @default(now())

  /// Last time this player's app said it was still there.
  ///
  /// A player closing the app does not get to say goodbye — the window is an
  /// iframe the game can take away — so a seat is held by a heartbeat rather
  /// than released by a departure. One that goes quiet is swept. See
  /// `SEAT_TIMEOUT` in lib/casino.ts.
  seenAt DateTime @default(now())

  /// One player, one chair.
  @@unique([tableId, position])
  @@unique([tableId, vrpId])
  /// Where is this player sitting? Asked on every load of every game page.
  @@index([vrpId])
}

/// The cards a table is dealing from.
///
/// Four decks by default, shuffled together: enough that counting them is work,
/// and few enough that the deal is still a deal rather than a random number
/// generator wearing a hat. The table owns exactly one, and it lasts as long as
/// the table has somebody at it — when the last player leaves, the shoe goes
/// with them, so the next player to sit down gets a fresh one rather than
/// inheriting whatever the last table left in it.
///
/// ── Nothing in here ever crosses to a browser ─────────────────────────────
/// `cards` is the whole shoe in dealing order, undealt cards included, and a
/// player who could read it would know every card before it was turned over.
/// It is loaded only inside lib/shoe.ts, and what leaves the server is a count
/// of what is left. There is deliberately no row-flattener for this model in
/// lib/rows.ts — the thing that exists to decide what a browser may see.
/// ─────────────────────────────────────────────────────────────────────────
model Shoe {
  id Int @id @default(autoincrement())

  table   Table @relation(fields: [tableId], references: [id], onDelete: Cascade)
  tableId Int   @unique

  /// How many decks are in *this* shuffle, drawn from the tier's range when
  /// the shoe was last restocked. Re-rolled on every restock, so it is a fact
  /// about the current shoe rather than a setting.
  decks Int @default(4)

  /// Every card, in the order it will be dealt, as a JSON array of two-
  /// character codes — `["AS","TD","2C"]`. See lib/shoe.ts for the notation.
  cards String

  /// How many have been dealt. Drawing is an increment, so two hands dealt at
  /// once cannot take the same card.
  cursor Int @default(0)

  /// The cut card: the cursor this shoe is retired at, once the round in
  /// progress has finished.
  ///
  /// Stored rather than computed because it is *random* — somewhere between a
  /// quarter and three quarters of the way in, drawn afresh each restock. A cut
  /// at a fixed depth is one a player can count towards; one they cannot see
  /// and cannot predict is what makes a running count stop being worth
  /// keeping. Never leaves the server, for the same reason the cards do not.
  cut Int @default(0)

  /// How many times this shoe has been re-shuffled since the table opened.
  /// Reaching the cut card re-shuffles rather than running the shoe dry.
  shuffles Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Something that happened, written down.
///
/// The point of an audit trail is that it does not change when the world does,
/// so nothing here is a foreign key to a player: names are copied in at the
/// time, and ids are plain integers. A row must still make sense when the
/// account it names has been renamed, demoted, or is simply gone.
model AuditEvent {
  id Int      @id @default(autoincrement())
  at DateTime @default(now())

  /// A key from the registry in lib/desk.ts — `deposit.closed`, `game.bet`
  /// and so on. Deliberately a string rather than an enum: games are still
  /// being built and each one brings events with it, and a schema migration is
  /// too high a price for adding a line to a log.
  action String

  /// Who did it. Absent when the app did it to itself.
  actorVrpId Int?
  actorName  String?
  /// What the actor was allowed to do at the time — the part of the record
  /// that a later demotion would otherwise erase.
  actorRole  Role?

  /// Who it was done to. The same person as the actor for anything a player
  /// does to their own account.
  subjectVrpId Int?
  subjectName  String?

  /// Chips the event moved, always positive. Which way is the action's to say.
  amount BigInt?
  /// The subject's balance once it had moved, so the trail can be read back as
  /// a ledger rather than a list of deltas that have to be re-added.
  balanceAfter BigInt?

  note String?
  /// Anything action-specific, as JSON. Read defensively — old rows were
  /// written by old code.
  detail String?

  request   Request? @relation(fields: [requestId], references: [id])
  requestId Int?

  /// The log's own order, which is how it is read by default.
  @@index([at])
  /// The audit tab's filters.
  @@index([action, at])
  @@index([actorVrpId, at])
  @@index([subjectVrpId, at])
  /// One request's history, for its modal.
  @@index([requestId])
}
