# Copy to `.env` for local development. Do not put production values here —
# `.env` is gitignored, this template is not.

# The local development database. Read by the Prisma CLI via prisma.config.ts
# (this is the name it looks for), and by the app when no Turso URL is set.
# Both resolve a relative `file:` path against the project root.
DATABASE_URL="file:./dev.db"

# Turso, in production. These are Turso's own variable names, so their Vercel
# and Netlify integrations inject them for you — a deployment usually needs
# nothing set by hand. Locally they are only needed to run `pnpm db:deploy`
# against a real database, which is why they are left empty here.
#
#   TURSO_DATABASE_URL="libsql://<database>-<org>.turso.io"
#   TURSO_AUTH_TOKEN="<turso db tokens create <database>>"
#
# Set, they take precedence over DATABASE_URL — so filling these in points the
# dev server at Turso rather than the local file. See DEPLOYMENT.md.
TURSO_DATABASE_URL=""
TURSO_AUTH_TOKEN=""

# Optional. Redis for query caching — see lib/db.ts for which models are cached
# and, more importantly, which deliberately are not.
#
# Left empty, caching is off and nothing tries to connect: development needs no
# Redis running. Redis being unreachable in production is also survivable, by
# design — cache errors are reported and never thrown, so queries fall through
# to the database.
#
#   REDIS_URL="redis://localhost:6379"
REDIS_URL=""
