{
  "name": "@tt/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "//": "Source is published, not build output. env.mjs is plain JavaScript on purpose — prisma.config.ts imports it from a bare Node process the Prisma CLI runs, before anything TypeScript has touched.",
  "exports": {
    ".": "./src/client.ts",
    "./env": "./src/env.mjs",
    "./migrate": "./src/migrate.mjs",
    "./prisma-config": "./src/prisma-config.ts",
    "./cache": "./src/cache.ts"
  },
  "scripts": {
    "lint": "eslint src"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "ioredis": "^6.0.0",
    "pg": "^8.13.0",
    "prisma-extension-redis": "^5.0.0",
    "server-only": "^0.0.1",
    "superjson": "^2.2.6"
  },
  "//peerDependencies": "The adapter and the CLI are pinned by the app, so a package cannot drift from the @prisma/client its generated code came from.",
  "peerDependencies": {
    "@prisma/adapter-pg": ">=7",
    "@prisma/client": ">=7.2",
    "prisma": ">=7"
  },
  "devDependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@types/node": "^20",
    "@types/pg": "^8.11.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "next": "16.3.0",
    "prisma": "^7.9.1",
    "typescript": "^5"
  }
}
