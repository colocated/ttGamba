{
  "name": "@tt/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "//": "Source is published, not build output. The .mjs files are plain JavaScript on purpose — `tt-db-deploy` runs under bare node, so deploying never depends on a TypeScript runner.",
  "exports": {
    ".": "./src/client.ts",
    "./env": "./src/env.mjs",
    "./migrate": "./src/migrate.mjs",
    "./prisma-config": "./src/prisma-config.ts",
    "./cache": "./src/cache.ts"
  },
  "bin": {
    "tt-db-deploy": "./bin/deploy.mjs"
  },
  "scripts": {
    "lint": "eslint src bin"
  },
  "dependencies": {
    "@libsql/client": "^0.17.4",
    "dotenv": "^17.4.2",
    "ioredis": "^6.0.0",
    "prisma-extension-redis": "^5.0.0",
    "server-only": "^0.0.1",
    "superjson": "^2.2.6"
  },
  "//peerDependencies": "The adapter and the CLI are pinned by the app, so a package cannot drift from the @prisma/client its generated code came from.",
  "peerDependencies": {
    "@prisma/adapter-libsql": ">=7",
    "@prisma/client": ">=7.2",
    "prisma": ">=7"
  },
  "devDependencies": {
    "@prisma/adapter-libsql": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@types/node": "^20",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "next": "16.3.0",
    "prisma": "^7.9.1",
    "typescript": "^5"
  }
}
